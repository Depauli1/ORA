{
  "name": "ora-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "ORA Protocol — modern toolchain for the orUSD borrowing protocol MVP",
  "scripts": {
    "compile": "hardhat compile",
    "chain": "hardhat node --hostname 0.0.0.0",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "app": "vite build && node server.js",
    "test": "hardhat test",
    "size": "node scripts/check-sizes.js",
    "gas": "hardhat run scripts/gas-snapshot.js",
    "gas:check": "GAS_CHECK=1 hardhat run scripts/gas-snapshot.js",
    "coverage": "COVERAGE=1 hardhat coverage && node scripts/coverage-gate.js",
    "build": "vite build",
    "app:dev": "node server.js",
    "dev": "vite",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run app/test/ --coverage"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.2",
    "chai": "^4.5.0",
    "hardhat": "^2.26.0",
    "jsdom": "^30.1.1",
    "solc": "0.6.11",
    "solc-0.8": "npm:solc@^0.8.24",
    "solidity-coverage": "^0.8.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.25.0",
    "ethers": "^6.17.0",
    "qrcode": "^1.5.4"
  }
}
